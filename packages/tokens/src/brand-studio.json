{
    "$meta": {
        "layer": "marque",
        "note": "Marque alternative de démonstration « studio » (5.12) : 6 primitives uniquement"
    },
    "mr": {
        "brand-studio": {
            "brand-hue": { "$value": "85", "$type": "number" },
            "brand-chroma": { "$value": "0.1", "$type": "number" },
            "neutral-hue": { "$value": "250", "$type": "number" },
            "font-sans": {
                "$value": "\"Inter\", ui-sans-serif, system-ui, sans-serif",
                "$type": "fontFamily"
            },
            "font-mono": {
                "$value": "\"JetBrains Mono\", ui-monospace, monospace",
                "$type": "fontFamily"
            },
            "radius-scale": { "$value": "0.5", "$type": "number" }
        }
    }
}
