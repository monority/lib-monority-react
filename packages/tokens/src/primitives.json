{
  "$meta": { "layer": "primitives", "note": "Seules valeurs modifiables par une marque (5.1)" },
  "mr": {
    "brand-hue": { "$value": "200", "$type": "number" },
    "brand-chroma": { "$value": "0.12", "$type": "number" },
    "neutral-hue": { "$value": "215", "$type": "number" },
    "font-sans": {
      "$value": "\"Geist Variable\", \"Geist\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "$type": "fontFamily"
    },
    "font-mono": {
      "$value": "\"Geist Mono Variable\", \"Geist Mono\", ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace",
      "$type": "fontFamily"
    },
    "radius-scale": { "$value": "1", "$type": "number" }
  }
}
