{
    "$meta": {
        "layer": "primitives",
        "note": "Seules valeurs modifiables par une marque (5.1). Préfixe --mr-ref-* : D11."
    },
    "mr": {
        "ref-brand-hue": { "$value": "200", "$type": "number" },
        "ref-brand-chroma": { "$value": "0.12", "$type": "number" },
        "ref-neutral-hue": { "$value": "215", "$type": "number" },
        "ref-neutral-chroma": { "$value": "0", "$type": "number" },
        "ref-font-sans": {
            "$value": "\"Geist Variable\", \"Geist\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
            "$type": "fontFamily"
        },
        "ref-font-mono": {
            "$value": "\"Geist Mono Variable\", \"Geist Mono\", ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace",
            "$type": "fontFamily"
        },
        "ref-radius-scale": { "$value": "1", "$type": "number" }
    }
}
