{
    "$meta": {
        "layer": "densité",
        "note": "Variantes compact + blocs structurels (5.13, 5.14, 5.11)"
    },
    "mr": {
        "density-compact": {
            "control-size-sm": { "$value": "28px", "$type": "dimension" },
            "control-size-md": { "$value": "32px", "$type": "dimension" },
            "control-size-lg": { "$value": "40px", "$type": "dimension" },
            "control-padding-inline-xs": { "$value": "4px", "$type": "dimension" },
            "control-padding-inline-sm": { "$value": "8px", "$type": "dimension" },
            "control-padding-inline-md": { "$value": "12px", "$type": "dimension" },
            "control-padding-inline-lg": { "$value": "16px", "$type": "dimension" },
            "control-font-size-sm": { "$value": "var(--mr-fs-12)", "$type": "dimension" },
            "control-font-size-md": { "$value": "var(--mr-fs-13)", "$type": "dimension" },
            "control-font-size-lg": { "$value": "var(--mr-fs-14)", "$type": "dimension" },
            "control-gap": { "$value": "6px", "$type": "dimension" },
            "card-padding": { "$value": "16px", "$type": "dimension" },
            "card-gap": { "$value": "12px", "$type": "dimension" },
            "table-head-height": { "$value": "28px", "$type": "dimension" },
            "table-row-height": { "$value": "32px", "$type": "dimension" },
            "table-cell-padding-inline": { "$value": "8px", "$type": "dimension" },
            "tabs-height": { "$value": "32px", "$type": "dimension" },
            "menu-item-height": { "$value": "28px", "$type": "dimension" },
            "stack-gap": { "$value": "8px", "$type": "dimension" },
            "section-gap": { "$value": "12px", "$type": "dimension" },
            "grid-gap": { "$value": "12px", "$type": "dimension" },
            "calendar-cell-size": { "$value": "28px", "$type": "dimension" }
        },
        "media-max640": {
            "page-padding": { "$value": "16px", "$type": "dimension" },
            "grid-gap": { "$value": "12px", "$type": "dimension" }
        },
        "motion-reduced": {
            "duration-fast": { "$value": "0ms", "$type": "duration" },
            "duration-base": { "$value": "0ms", "$type": "duration" },
            "duration-slow": { "$value": "0ms", "$type": "duration" },
            "duration-spin": { "$value": "1600ms", "$type": "duration" },
            "duration-pulse": { "$value": "0ms", "$type": "duration" }
        }
    }
}
