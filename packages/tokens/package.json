{
    "name": "@monority/tokens",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node ./scripts/build.mjs",
        "build:downstream": "node ./scripts/build-downstream.mjs",
        "build:downstream:web": "node ./scripts/build-downstream.mjs --web",
        "test": "pnpm build",
        "clean": "node -e \"const fs=require('fs'); for (const p of ['dist','../styles/src/tokens/generated']) fs.rmSync(p,{recursive:true,force:true})\""
    },
    "devDependencies": {
        "colorjs.io": "^0.7.1",
        "style-dictionary": "^4.0.0"
    }
}
