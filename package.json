{
    "name": "monority",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "workspaces": ["apps/*", "packages/*", "tooling/*"],
    "scripts": {
        "dev": "pnpm --filter @monority/web dev",
        "build": "turbo run build",
        "build:ui": "pnpm --filter @monority/ui build",
        "build:web": "pnpm --filter @monority/web build",
        "lint": "biome lint .",
        "lint:css": "node ./tooling/scripts/lint-css.mjs",
        "test": "turbo run test && pnpm test:stylelint",
        "test:watch": "turbo run test:watch",
        "clean": "turbo run clean && node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\"",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "typecheck": "turbo run typecheck",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "turbo run build && changeset publish",
        "generate:component": "pnpm --filter @monority/generators generate:component",
        "validate": "node tooling/scripts/validate.js",
        "test:stylelint": "node --test ./tooling/stylelint/rules.test.mjs",
        "audit:scope": "node ./packages/tokens/scripts/check-audit-scope.mjs",
        "test:audit-scope": "node --test ./packages/tokens/scripts/audit-scope.test.mjs",
        "verify": "node ./tooling/scripts/verify.mjs",
        "check:test-skips": "node ./packages/tokens/scripts/check-test-skips.mjs",
        "test:test-skips": "node --test ./packages/tokens/scripts/test-skips.test.mjs",
        "test:token-pattern": "node --test ./tooling/tokens/token-pattern.test.mjs",
        "audit:tokens": "node ./packages/tokens/scripts/audit-tokens.mjs",
        "test:audit-tokens": "node --test ./packages/tokens/scripts/audit-tokens.test.mjs"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.0",
        "@changesets/cli": "^2.27.0",
        "stylelint": "16",
        "turbo": "^2.3.0",
        "typescript": "^5.7.0"
    },
    "packageManager": "pnpm@9.0.0",
    "engines": {
        "node": ">=20"
    }
}
