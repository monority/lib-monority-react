{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "permission": "allow",
  "agent": {
    "orchestrator": {
      "description": "Orchestrateur du pipeline Plan ? Build ? Review",
      "mode": "all",
      "model": "opencode-go/qwen3.5-plus",
      "temperature": 0,
      "color": "#9B59B6",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": {
          "reasoner": "allow",
          "coder": "allow",
          "reviewer": "allow"
        },
        "webfetch": "allow"
      }
    },
    "reasoner": {
      "description": "Analyse/debug/architecture (lecture seule), cause racine, plan",
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "temperature": 0,
      "color": "#EDB84C",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": "allow",
        "webfetch": "allow"
      }
    },
    "coder": {
      "description": "Implémentation TS/React + UI/CSS + tests + doc + scaffold",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "temperature": 0,
      "color": "#5B9BD5",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": "allow",
        "webfetch": "allow"
      }
    },
    "reviewer": {
      "description": "Code review, quality gates, conventions — lecture seule",
      "mode": "subagent",
      "model": "opencode-go/minimax-m2.7",
      "temperature": 0,
      "color": "#6BAF8E",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow"
      }
    }
  }
}

